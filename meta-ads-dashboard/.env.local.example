# Copy this file to .env.local and fill in a Meta System User access token
# with ads_read permission on both tracked ad accounts (act_1002719109265256
# and act_1204405088105936). Generate one in Meta Business Settings ->
# System Users -> Generate New Token, or via the Graph API Explorer for a
# quick local test (short-lived tokens expire in ~1 hour).
#
# Without this variable set, the dashboard falls back to the bundled
# lib/seed/meta-ads-seed.json snapshot (a real last-30-days pull captured
# on 2026-08-19) so the UI still renders fully offline.
META_ACCESS_TOKEN=
