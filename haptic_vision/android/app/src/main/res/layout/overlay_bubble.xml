<?xml version="1.0" encoding="utf-8"?>
<!-- The whole UI of this app while it is in use: one 56dp circle that either
     shows a dot (idle) or a spinner (request in flight). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bubble_root"
    android:layout_width="56dp"
    android:layout_height="56dp"
    android:background="@drawable/bubble_idle"
    android:elevation="6dp">

    <View
        android:id="@+id/bubble_dot"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_gravity="center"
        android:background="@drawable/bubble_dot" />

    <ProgressBar
        android:id="@+id/bubble_spinner"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="center"
        android:indeterminateTint="#FFFFFFFF"
        android:visibility="gone" />
</FrameLayout>
